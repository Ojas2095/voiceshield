# VoiceShield Environment Variables
# Copy this file to .env and fill in real values

# === Backend Security ===
SECRET_KEY=placeholder_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_CLIENT_ID=demo_user
DEMO_CLIENT_SECRET=demo_password

# === CORS Allowed Origins ===
# Comma-separated or default http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# === AI/ML Model Configuration ===
USE_DUMMY_MODEL=false
MODEL_WEIGHTS_DIR=./ai/models
WAV2VEC_MODEL_NAME=facebook/wav2vec2-large-xlsr-53

# === Detection & Risk Parameters ===
RISK_THRESHOLD=0.70

# === PostgreSQL Database ===
DATABASE_URL=postgresql+asyncpg://voiceshield_user:voiceshield_pass@localhost:5432/voiceshield
# For local fallback/testing: DATABASE_URL=sqlite+aiosqlite:///./voiceshield.db
