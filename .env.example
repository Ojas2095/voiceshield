# VoiceShield Environment Variables
# Copy this file to .env and fill in real values

# === Backend ===
DATABASE_URL=sqlite:///./voiceshield.db
# For production: DATABASE_URL=postgresql://user:pass@localhost:5432/voiceshield
SECRET_KEY=change-me-to-a-random-string
EVIDENCE_SIGNING_KEY_PATH=./keys/ed25519_private.pem

# === AI/ML ===
MODEL_WEIGHTS_DIR=./ai/models
WAV2VEC_MODEL_NAME=facebook/wav2vec2-large-xlsr-53

# === Layer 2 (ASR + Intent) ===
WHISPER_MODEL_SIZE=base
# If using an LLM API for intent (optional, has offline fallback):
# LLM_API_KEY=sk-...
# LLM_API_URL=http://localhost:11434/api/generate

# === Frontend ===
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/audio
