# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Environment variables (never commit live secrets)
.env
.env.local
.env.*.local
.env.development
.env.production

# Datasets (fetched/generated locally — never commit, can be many GB)
data/
!data/.gitkeep
*.wav

# Model binary weights (keep threshold.json committed)
*.pt
*.bin
*.safetensors
*.onnx

# Signing keys
keys/

# Node / Next.js
node_modules/
**/node_modules/
frontend/.next/
frontend/out/

# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Database files
*.db
*.sqlite3
test_*.db
