# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Environment variables (never commit live secrets)
.env
.env.local
.env.*.local
.env.development
.env.production

# Datasets (fetched/generated locally — never commit, can be many GB)
/data/
*.wav
# ...but DO commit the demo-call audio and intent benchmark
!frontend/public/demo/*.wav
!intelligence/data/intent_samples.csv

# Model binary weights (keep threshold.json committed)
*.pt
*.bin
*.safetensors
*.onnx
# ...but DO commit the trained MelCNN weights (3.2 MB) for self-contained evaluation
!ai/models/best_mel_cnn.pt

# Signing keys
keys/

# Node / Next.js
node_modules/
**/node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo

# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Database files
*.db
*.sqlite3
test_*.db

# Design reference (Stitch export) — local only, never publish
/Google Stitch/
